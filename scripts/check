#!/bin/zsh
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.

# Tests the package, builds the app for iOS Simulator and macOS without code
# signing, lints the source and refuses tracked signing values. The pre-push
# hook and CI run this. `scripts/check signing` runs the signing step alone,
# and `scripts/test-signing-check` tests that step.
set -euo pipefail

cd "${0:A:h:h}"

# What the signing step looks for. It reads the index, so a staged value is
# found whatever the working tree holds, and it fails when git fails, so an
# error cannot pass for a clean tree.
#
# A line assigns to a setting as `KEY = value`, `KEY[sdk=*][arch=*] = value`,
# the project file's `KEY = "value";`, a command line's `KEY=value`, or
# `KEY: value` and `"KEY": "value"` anywhere on a line, as YAML, JSON and a
# Swift dictionary literal write it. Lines are lowered before they are matched,
# so the settings are lower case here.
conditions='(\[[^]]*\])*"?[[:space:]]*'
setting_keys=(team prefix identifier identity profile)
typeset -A setting_pattern
setting_pattern[team]='development_?team'
setting_pattern[prefix]='bundle_id_prefix'
setting_pattern[identifier]='product_bundle_identifier'
setting_pattern[identity]='code_sign_identity'
setting_pattern[profile]='provisioning_profile(_specifier)?'

# What a property list holds under these keys: a team, and a bundle identifier.
# A file git treats as binary is refused when it names any setting or key.
plist_team_keys='(development_?team|team_?id|com\.apple\.developer\.team-identifier)'
binary_patterns=(cfbundleidentifier team-identifier 'team_?id')

# A team id is 10 characters from A to Z and 0 to 9, with at least one letter.
# In an entitlement it stands alone or begins an identifier such as
# `ABCDE12345.com.example`. `$(AppIdentifierPrefix)` is the reference form.
team_id_value='^[A-Z0-9]{10}(\.[^<]*)?$'

# An unquoted word: references, which can hold any character, and everything up
# to a space, a semicolon, a comma or a closing brace or bracket.
unquoted_word='^(\$\([^)]*\)|\$\{[^}]*\}|[^][:space:];,}])+'

# A key and its string in a property list, and any string in one.
plist_pair='<key>([^<]*)</key>[[:space:]]*<string>([^<]*)</string>'
plist_string='<string>([^<]*)</string>'

# A value that is only references, such as $(inherited), ${NAME} or $NAME.
reference_only='^(\$\([^)]*\)|\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*)+$'

# Sets REPLY to the first word of the text after an equals sign or colon that
# is not a reference, or to nothing when there is none. A word ends at a space,
# a semicolon, a comma or a closing brace or bracket, a quoted word ends at its
# closing quote, a closing character with no word before it ends the value, and
# `//` starts a comment.
first_literal() {
  setopt local_options extended_glob
  local rest="$1" word
  REPLY=
  while true; do
    rest="${rest##[[:space:]]#}"
    [[ -z "$rest" || "$rest" == (//|\;|,|\}|\]|\))* ]] && return 0
    if [[ "$rest" == \"* ]]; then
      rest="${rest#\"}"
      word="${rest%%\"*}"
      rest="${rest:$(( ${#word} + 1 ))}"
    else
      [[ "$rest" =~ $unquoted_word ]]
      word="${MATCH}"
      rest="${rest:${#word}}"
      if [[ "$word" == *//* ]]; then
        word="${word%%//*}"
        rest=
      fi
    fi
    if [[ -n "$word" && ! "$word" =~ $reference_only ]]; then
      REPLY="$word"
      return 0
    fi
  done
}

# Prints a reason for each value on one line that belongs on the signing
# machine. A comment line and a comparison such as `==` are skipped.
line_problems() {
  setopt local_options extended_glob
  local line="$1" key form pattern lowered rest
  local -i end
  [[ "${line##[[:space:]]#}" == //* ]] && return 0
  for key in $setting_keys; do
    for form in equals colon; do
      if [[ $form == equals ]]; then
        pattern="(^|[^a-z0-9_])${setting_pattern[$key]}${conditions}="
      else
        pattern="(^|[^a-z0-9_])${setting_pattern[$key]}${conditions}:"
      fi
      lowered="${line:l}"
      rest="$line"
      while [[ "$lowered" =~ $pattern ]]; do
        end=$MEND
        rest="${rest:$end}"
        lowered="${lowered:$end}"
        [[ "$rest" == [=~]* ]] && continue
        first_literal "$rest"
        case $key in
          team) [[ -n "$REPLY" ]] && print -r -- 'sets a development team' ;;
          profile) [[ -n "$REPLY" && "$REPLY" != - ]] && print -r -- 'sets a provisioning profile' ;;
          identity) [[ -n "$REPLY" && "$REPLY" != - ]] && print -r -- 'sets a code signing identity' ;;
          prefix) [[ -n "$REPLY" && "$REPLY" != com.example ]] \
            && print -r -- 'sets the bundle identifier prefix to something other than com.example' ;;
          identifier) [[ -n "$REPLY" && "$REPLY" != (\$\(|\$\{)BUNDLE_ID_PREFIX(\)|\})* ]] \
            && print -r -- 'sets a bundle identifier that does not start with the prefix' ;;
        esac
      done
    done
  done
  return 0
}

# Runs a command whose output is read by the caller and exits 1 for no match.
# Any other failure stops the check.
index_query() {
  local -i code=0
  REPLY="$("$@")" || code=$?
  if (( code > 1 )); then
    print -u2 -r -- "signing check: \`${*[1,3]}\` failed with status ${code}"
    exit 1
  fi
}

# Fails when a tracked file carries a value that belongs on the signing
# machine: a development team, a bundle identifier prefix other than
# com.example, a bundle identifier that skips the prefix, a signing identity or
# provisioning profile, a team id in a property list, or a signing asset such
# as a key or certificate. A file that git treats as binary and that names a
# signing setting is refused, because the step cannot read it.
check_signing_values() {
  setopt local_options extended_glob
  local -i failed=0
  local entry file number line problem content key plist_key value rest
  local -a plists grep_args binary_args
  local -A text_files

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    print -u2 'signing check: not inside a git repository, so nothing can be checked'
    return 1
  fi

  # One line at a time, from the index.
  for key in $setting_keys; do grep_args+=(-e "${setting_pattern[$key]}"); done
  index_query git grep --cached -nIiE $grep_args -- .
  for entry in "${(@f)REPLY}"; do
    [[ -n "$entry" ]] || continue
    file="${entry%%:*}"
    number="${${entry#*:}%%:*}"
    line="${${entry#*:}#*:}"
    for problem in "${(@f)$(line_problems "$line")}"; do
      [[ -n "$problem" ]] || continue
      print -u2 -r -- "${file}:${number}: ${problem}"
      failed=1
    done
  done

  # A file git treats as binary is skipped by the search above, so it is found
  # here and refused when it names a setting or a key.
  for key in $setting_keys; do binary_args+=(-e "${setting_pattern[$key]}"); done
  for key in $binary_patterns; do binary_args+=(-e "$key"); done
  index_query git grep --cached -lzIiE $binary_args -- .
  for file in "${(@0)REPLY}"; do text_files[$file]=1; done
  index_query git grep --cached -lziE $binary_args -- .
  for file in "${(@0)REPLY}"; do
    [[ -n "$file" && -z "${text_files[$file]-}" ]] || continue
    print -u2 -r -- "${file}: is a binary file that names a signing setting, so it cannot be read"
    failed=1
  done

  # A property list holds a key and its value on separate lines, and an
  # entitlement can hold a team id in any string.
  index_query git grep --cached -lzIE '<key>' -- .
  plists=("${(@0)REPLY}")
  for file in $plists; do
    [[ -n "$file" ]] || continue
    content="$(git show ":${file}")" || { print -u2 "signing check: cannot read ${file}"; return 1; }
    rest="$content"
    while [[ "$rest" =~ $plist_pair ]]; do
      rest="${rest:$MEND}"
      plist_key="${${${match[1]##[[:space:]]#}%%[[:space:]]#}:l}"
      value="${${match[2]##[[:space:]]#}%%[[:space:]]#}"
      [[ -n "$value" ]] || continue
      if [[ "$plist_key" =~ ^${plist_team_keys}$ ]]; then
        [[ ! "$value" =~ $reference_only ]] || continue
        print -u2 -r -- "${file}: sets a development team in a property list"
        failed=1
      elif [[ "$plist_key" == cfbundleidentifier ]] \
        && [[ "$value" != (\$\(|\$\{)(BUNDLE_ID_PREFIX|PRODUCT_BUNDLE_IDENTIFIER)(\)|\})* ]] \
        && [[ "$value" != com.example(|.*) ]]; then
        print -u2 -r -- "${file}: sets a bundle identifier that does not start with the prefix"
        failed=1
      fi
    done
    rest="$content"
    while [[ "$rest" =~ $plist_string ]]; do
      rest="${rest:$MEND}"
      value="${${match[1]##[[:space:]]#}%%[[:space:]]#}"
      if [[ "$value" =~ $team_id_value && "$value" == *[A-Z]* ]]; then
        print -u2 -r -- "${file}: has a team id in a property list value"
        failed=1
      fi
    done
  done

  # Signing assets and the local config stay on the machine that signs.
  index_query git ls-files -z -- \
    ':(icase)*.mobileprovision' ':(icase)*.provisionprofile' ':(icase)*.p12' \
    ':(icase)*.pfx' ':(icase)*.cer' ':(icase)*.crt' ':(icase)*.der' ':(icase)*.pem' \
    ':(icase)*.key' ':(icase)*.p8' ':(icase)*exportoptions.plist' 'Config/Local.xcconfig'
  for file in "${(@0)REPLY}"; do
    [[ -n "$file" ]] || continue
    print -u2 -r -- "${file}: is a signing asset or the local config"
    failed=1
  done

  if (( failed )); then
    print -u2 'A tracked file carries signing values. Keep them in Config/Local.xcconfig.'
    return 1
  fi
}

if [[ "${1:-}" == signing ]]; then
  check_signing_values
  exit
fi

print -- '==> Signing check tests'
scripts/test-signing-check

print -- '==> Package tests'
swift test --package-path VPNCore

for platform in 'iOS Simulator' macOS; do
  print -- "==> Build for ${platform}"
  xcodebuild build \
    -quiet \
    -project VPN.xcodeproj \
    -scheme VPN \
    -destination "generic/platform=${platform}" \
    -derivedDataPath build/DerivedData \
    CODE_SIGNING_ALLOWED=NO
done

print -- '==> SwiftFormat'
if ! command -v swiftformat >/dev/null 2>&1; then
  print -u2 'swiftformat is not installed.'
  exit 1
fi
swiftformat --lint . --exclude build,.build

print -- '==> Signing values'
check_signing_values

print -- 'Passed.'
